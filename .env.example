# EFRISConnect — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit the actual .env file to Git — it is listed in .gitignore.

# Port the Express server listens on (default: 3000)
PORT=3000

# EFRIS private key — either:
#   a) The full PEM content (paste the key directly, newlines as \n)
#   b) A file path to the PEM file (e.g. /app/keys/efris_private.pem)
# In a container, pass it as an environment variable (or EFRIS_PRIVATE_KEY_B64).
EFRIS_PRIVATE_KEY=

# Internal API key — protects all /api/* routes from outside callers.
# If not set, a random key is generated at startup (valid for that session only).
# Set a stable value here so the key survives container restarts.
INTERNAL_API_KEY=

# Browser origins (besides loopback) allowed to call the relay and frame the
# extension, comma separated. Manager Desktop on localhost needs nothing here.
# Example for a cloud Manager: ALLOWED_ORIGINS=https://manager.example.com
ALLOWED_ORIGINS=

# Hostnames (besides localhost/127.0.0.1) the relay answers to. Blocks DNS
# rebinding. Set this when BIND_HOST is not loopback, e.g. ALLOWED_HOSTS=efris.example.com
ALLOWED_HOSTS=

# Reverse proxies whose X-Forwarded-For is trusted (Express "trust proxy" syntax).
# Default "loopback" (a proxy or tunnel on this machine). Example: TRUST_PROXY=10.0.0.5
TRUST_PROXY=
