{
  "name": "efrisconnect-backend",
  "version": "1.0.28",
  "description": "EFRISConnect - URA EFRIS receipting and goods configuration for Manager.io",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "nodemailer": "^10.2.1"
  },
  "devDependencies": {
    "jest": "^30.4.2",
    "nodemon": "^3.0.1",
    "supertest": "^7.2.2"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "optionalDependencies": {
    "@primno/dpapi": "^2.0.1"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "<rootDir>/__tests__/**/*.test.js"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/__tests__/helpers/setup.js"
    ],
    "testTimeout": 20000,
    "maxWorkers": 1,
    "transform": {}
  }
}
